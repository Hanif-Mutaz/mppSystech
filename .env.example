# Salin jadi .env (jangan di-commit). Dibaca otomatis oleh server.
# Koneksi PostgreSQL (WAJIB).
MPP_DATABASE_URL=postgresql://mpp:GANTI_PASSWORD@127.0.0.1:5432/mpp
# Port server (default 5000). stop_server.bat ikut membaca nilai ini.
# MPP_PORT=5000
# Jaringan yang boleh mengakses server (CIDR, pisah koma). Default: LAN/privat + localhost.
# MPP_ALLOWED_NETS=192.168.147.0/24,127.0.0.0/8
# USB scanner serial/COM. Kosong = auto-detect.
MPP_SCANNER_PORT=COM3
MPP_SCANNER_BAUD=9600
MPP_SCANNER_ENCODING=utf-8
# Token untuk webhook fingerprint. WAJIB: tanpa ini semua event fingerprint ditolak.
MPP_DEVICE_TOKEN=GANTI_TOKEN_RAHASIA
